{
  "name": "helmryth",
  "private": true,
  "version": "0.1.0",
  "description": "A private operating system for autonomous work.",
  "tagline": "The work moves. You hold the helm.",
  "author": "Helmryth Contributors",
  "license": "Apache-2.0",
  "desktopName": "com.helmryth.app.desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "lint": "oxlint .",
    "check:brand": "node scripts/check-brand-residue.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:qa-docs": "node scripts/check-qa-coverage.mjs",
    "check:packaged": "node scripts/check-packaged-imports.mjs",
    "dev": "vite",
    "docs:dev": "pnpm --filter @helmryth/docs dev",
    "docs:build": "pnpm --filter @helmryth/docs build",
    "docs:preview": "pnpm --filter @helmryth/docs preview",
    "companion": "node --experimental-strip-types companion/src/index.ts",
    "dev:server": "node --experimental-strip-types server/index.ts",
    "mcp": "node --experimental-strip-types scripts/mcp-server.ts",
    "dev:desktop": "node scripts/prepare-cloudflared.mjs --current && electron .",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "node scripts/test-floor.mjs && pnpm conduit:test && pnpm test:updater && pnpm test:desktop-viewer && pnpm test:package-link && pnpm test:save-file && pnpm test:server-boot-probe && pnpm test:packaged-server",
    "test:updater": "node --test electron/updater-coordinator.node-test.mjs electron/update-channel.node-test.mjs",
    "test:desktop-viewer": "node --test electron/desktop-viewer.node-test.mjs electron/desktop-workspace.node-test.mjs electron/external-url.node-test.mjs",
    "test:package-link": "node --test electron/package-link.node-test.mjs",
    "test:save-file": "node --test electron/save-file.node-test.mjs",
    "test:server-boot-probe": "node --test electron/server-boot-probe.node-test.mjs",
    "bench:observation": "node --experimental-strip-types scripts/bench-observation.ts",
    "test:watch": "vitest",
    "test:cua": "pnpm build:cua && node scripts/smoke-cua.mjs",
    "test:cua-container": "node scripts/smoke-cua-container.mjs",
    "check:electron": "node scripts/check-electron.mjs",
    "preview": "vite preview",
    "build:server": "tsc -p tsconfig.server.build.json && node scripts/bundle-server.mjs",
    "build:companion": "tsc -p tsconfig.companion.build.json",
    "build:speech": "node electron/build-speech-helper.mjs",
    "build:recorder": "node electron/build-recorder-helper.mjs",
    "build:cua": "node scripts/prepare-cua.mjs",
    "build:android-tools": "node scripts/prepare-android-tools.mjs",
    "build:cloudflared": "node scripts/prepare-cloudflared.mjs",
    "build:cua:linux": "node scripts/prepare-cua-linux.mjs",
    "build:cua:linux:offline": "node scripts/prepare-cua-linux.mjs --offline",
    "build:updater": "node scripts/bundle-updater.mjs",
    "build:browser-snapshot": "node scripts/build-browser-snapshot.mjs",
    "build:icons": "node build/generate-icons.mjs",
    "package:prepare": "pnpm build && pnpm build:server && pnpm build:companion && pnpm build:updater && pnpm build:android-tools && pnpm build:cloudflared",
    "package:mac": "pnpm package:prepare && pnpm build:speech && pnpm build:recorder && pnpm build:cua && electron-builder --mac --publish never",
    "package:win": "pnpm package:prepare && electron-builder --win --publish never",
    "package:linux": "pnpm package:prepare && pnpm build:cua:linux && electron-builder --linux --x64 --publish never",
    "package:linux:offline": "pnpm package:prepare && pnpm build:cua:linux:offline && electron-builder --linux --x64 --publish never",
    "smoke:linux-package": "node scripts/run-linux-package-smoke.mjs",
    "smoke:cua-x11-input": "node scripts/smoke-cua-x11-input.mjs",
    "package:linux:dir": "pnpm package:prepare && pnpm build:cua:linux && electron-builder --linux dir --x64 --publish never",
    "package:release:mac": "node scripts/package-release.mjs --target mac",
    "package:release:win": "node scripts/package-release.mjs --target win",
    "package:release:linux": "node scripts/package-release.mjs --target linux",
    "package:release:linux:offline": "node scripts/package-release.mjs --target linux --offline",
    "release:config:check": "node scripts/release-builder-config.mjs --check",
    "package": "pnpm package:mac",
    "test:packaged-server": "pnpm build:server && node scripts/smoke-packaged-server.mjs",
    "conduit:types": "pnpm --filter @helmryth/conduit types",
    "conduit:check": "pnpm --filter @helmryth/conduit check",
    "conduit:test": "pnpm --filter @helmryth/conduit test",
    "conduit:dry-run": "pnpm --filter @helmryth/conduit dry-run",
    "conduit:preflight": "pnpm --filter @helmryth/conduit preflight",
    "conduit:preflight:test": "pnpm --filter @helmryth/conduit preflight:test",
    "conduit:deploy": "pnpm --filter @helmryth/conduit run deploy:production",
    "registry:types": "pnpm --filter @helmryth/registry types",
    "registry:check": "pnpm --filter @helmryth/registry check",
    "registry:test": "pnpm --filter @helmryth/registry test",
    "registry:dry-run": "pnpm --filter @helmryth/registry dry-run",
    "registry:preflight": "pnpm --filter @helmryth/registry preflight",
    "registry:preflight:test": "pnpm --filter @helmryth/registry preflight:test",
    "registry:deploy": "pnpm --filter @helmryth/registry run deploy:production"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/geologica": "5.3.0",
    "@trycua/cua-driver": "0.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "posthog-js": "^1.415.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "oxlint": "1.80.0",
    "tailwindcss": "^4.1.11",
    "typebox": "1.3.7",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "cpu": [
        "arm64",
        "x64"
      ]
    }
  }
}
