# Helmryth ignore rules.
#
# Scope: this file covers the repository root and every workspace that does not
# ship its own rules. `ios/.gitignore` owns SwiftPM and Xcode output;
# `apps/docs/.gitignore` owns the Next.js docs site. Keep tool-specific rules
# next to the tool rather than duplicating them here.
#
# Note `build/` is deliberately absent: it holds real source — app icons,
# `entitlements.mac.plist`, and `linux-after-install.sh` — that
# `electron-builder.yml` reads at package time.

# --- Dependencies -----------------------------------------------------------
node_modules

# --- Build output -----------------------------------------------------------
/dist
/dist-electron
/dist-native
/dist-server
# the sidecar's compiled entry — regenerated by `pnpm build:companion`,
# which package:prepare runs before electron-builder stages it
/dist-companion
/release
*.tsbuildinfo

# Helper apps and binaries staged into the packaged Electron app. The `.swift`
# sources and Info.plists next to these stay committed; only the compiled
# products are generated.
electron/resources/speech-helper
electron/resources/recorder-helper
electron/resources/Helmryth Speech.app
electron/resources/Helmryth Recorder.app

# esbuild bundle of the electron-updater devDependency, rebuilt by
# `pnpm build:updater` inside `package:prepare` on every release.
electron/vendor/

# Icon intermediates. `generate-icons.mjs` rasterises these with macOS `sips`
# and folds them into icon.icns/icon.ico with `iconutil`. The Windows and Linux
# packaging runners have neither tool, so the finished icons stay committed
# while this scratch does not.
build/icon.iconset/
build/icon.ico-pngs/

# Cloudflare Worker types are generated by `wrangler types`.
cloudflare/composio-broker/worker-configuration.d.ts
cloudflare/control-plane/worker-configuration.d.ts

# --- Test, QA, and profiling artifacts --------------------------------------
output/
test-results/
playwright-report/
coverage/
.playwright-cli/

# --- Secrets and local environment ------------------------------------------
# Never commit real credentials. The one checked-in template is the control
# plane's `.dev.vars.example`, re-included by the negation below.
.env
.env.*
.dev.vars
.dev.vars.*
!cloudflare/control-plane/.dev.vars.example
*.local
.npmrc

# Signing material and private keys.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision

# Internal rebrand reference captures. These are screen recordings of the
# pre-rebrand product — old shell, old mascot sigils, old "bot" vocabulary, and
# a collaborator's name in the sidebar. Nothing in the tree links to them, and
# publishing them would put the retired identity back into the public repo.
# Kept on disk as internal evidence; never committed.
docs/internal-provenance/

# --- Local tooling state ----------------------------------------------------
.wrangler/
.vercel/
.pi/
.hry-scratch
.worktrees/
.claude/worktrees/
# OMC session/agent state — local tooling, never part of the product
.omc/
# Scratch from tools that write a temp file next to their target. No real
# source in this tree uses the extension.
*.tmp

# --- Editor and OS noise ----------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Logs -------------------------------------------------------------------
*.log
