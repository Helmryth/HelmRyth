{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "helmryth-registry-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "HELMRYTH_REGISTRY_ORIGIN": "https://registry.helmryth.test",
    "HELMRYTH_EMAIL_FROM": "noreply@helmryth.test",
    "HELMRYTH_NODE_ORIGINS": "https://desktop.helmryth.test",
    "CLOUDFLARE_ACCOUNT_ID": "00000000000000000000000000000000",
    "CLOUDFLARE_ZONE_ID": "00000000000000000000000000000000",
    "HELMRYTH_REACH_HOST_SUFFIX": "reach.helmryth.test",
    "HELMRYTH_REACH_ORIGIN": "http://127.0.0.1:8812"
  },
  "secrets": {
    "required": ["HELMRYTH_REGISTRY_AUTH_SECRET", "CLOUDFLARE_API_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "REGISTRY_DB",
      "database_name": "helmryth-registry-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "REGISTRY_EMAIL",
      "allowed_sender_addresses": ["noreply@helmryth.test"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
